# Server Port
PORT=5000

# PostgreSQL Connection from Aiven (e.g. postgresql://avnadmin:password@pg-service.aivencloud.com:port/defaultdb?sslmode=require)
DATABASE_URL=

# SSL Mode for Database (defaults to true for cloud like Aiven)
DB_SSL=true

# JWT Secret for Admin Session Tokens
JWT_SECRET=techawaken-super-secret-jwt-key-2026

# Default Admin Credentials for Initial Setup
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=TechAwaken@2026
